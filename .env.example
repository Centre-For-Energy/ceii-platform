# ──────────────────────────────────────────────────────────────────────────
# CEII platform — environment variables (template)
# Copy to `.env` and fill in. Never commit a real `.env`.
# ──────────────────────────────────────────────────────────────────────────

# PostgreSQL (local dev defaults)
POSTGRES_USER=ceii
POSTGRES_PASSWORD=ceii
POSTGRES_DB=ceii

# Backend — used by local development and migration commands
DATABASE_URL=postgresql+psycopg://ceii:ceii@localhost:5432/ceii

# ── Strapi CMS secrets ────────────────────────────────────────────────────
# These are DEVELOPMENT PLACEHOLDERS. Before any non-local deployment,
# generate real values, e.g.:
#   openssl rand -base64 32
# APP_KEYS takes a comma-separated list of at least two values.
APP_KEYS=replace-me-with-generated,comma-separated,app-keys
API_TOKEN_SALT=replace-me-with-generated-salt
ADMIN_JWT_SECRET=replace-me-with-generated-secret
TRANSFER_TOKEN_SALT=replace-me-with-generated-salt
JWT_SECRET=replace-me-with-generated-secret